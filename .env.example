# URL pública del sitio. Se usa para sitemap, canonical y etiquetas Open Graph.
# En producción dejala apuntando al dominio real (p. ej. https://www.movisun.com.co).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API bajo construcción: mientras no esté lista la API real,
# la app consume mocks servidos por los route handlers de src/app/api/v1/*.
#
# Cuando la API real esté disponible, apunta aquí (y borra src/app/api/v1/):
# API_BASE_URL=https://api.movisun.com.co
# NEXT_PUBLIC_API_BASE_URL=https://api.movisun.com.co