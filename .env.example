# URL pública del sitio. Se usa para sitemap, canonical y etiquetas Open Graph.
# En producción dejala apuntando al dominio real (p. ej. https://www.movisun.com.co).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Conexión a PostgreSQL (Supabase). Solo se lee en el servidor:
# NUNCA le pongas el prefijo NEXT_PUBLIC_ o quedaría expuesta en el navegador.
#
# En Supabase: botón Connect → cadena del pooler en modo Transaction (puerto 6543),
# no la conexión directa. Reemplazá [YOUR-PASSWORD] por la contraseña del proyecto.
#
# Después de configurarla, creá las tablas y cargá el catálogo inicial:
#   npm run db:setup              (carga solo si la base está vacía)
#   npm run db:setup -- --reset   (borra todo y vuelve a cargar)
DATABASE_URL=postgresql://usuario:contraseña@host.pooler.supabase.com:6543/postgres

# Origen de la API. La API vive dentro de este mismo proyecto Next.js
# (src/app/api/v1), así que en desarrollo alcanza con el valor por defecto.
# API_BASE_URL=http://localhost:3000

# ─── Panel de administración ────────────────────────────────────────────────
# Contraseña única de acceso a /admin. No hay tabla de usuarios.
ADMIN_PASSWORD=

# Secreto para firmar la cookie de sesión. Generalo con:
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ─── WhatsApp ───────────────────────────────────────────────────────────────
# Celular que recibe los pedidos del carrito y el del botón flotante.
# Colombiano de 10 dígitos; se acepta escrito como 3201234567,
# +57 320 123 4567 o 573201234567.
# Este archivo se sube a git: no le pongas el número real, va en .env.local.
WHATSAPP_VENTAS=
